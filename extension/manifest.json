{
  "manifest_version": 3,
  "name": "Keen",
  "version": "1.0",
  "description": "Your personalized shopping assistant.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["content/shared.js", "content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.noon.com/*"],
      "js": ["content/shared.js", "content/noon.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.jumia.com.eg/*", "*://*.jumia.com/*"],
      "js": ["content/shared.js", "content/jumia.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["activeTab", "storage"]
}